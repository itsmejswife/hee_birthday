
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Happy Birthday Lee Heeseung ♡</title>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Pacifico&family=Poppins:wght@300;400;600;700&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      overflow: hidden;
      background: linear-gradient(135deg, #160d20, #38213e, #17111f);
      font-family: 'Poppins', sans-serif;
      color: white;
    }

    /* Tulisan HAPPY BIRTHDAY berjatuhan */
    .rain {
      position: fixed;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: 0;
    }

    .falling {
      position: absolute;
      top: -100px;
      color: #ffb6d9;
      font-size: 15px;
      font-weight: 600;
      white-space: nowrap;
      text-shadow: 0 0 12px #ff5eae;
      opacity: 0.8;
      animation: fall linear infinite;
    }

    @keyframes fall {
      0% {
        transform: translateY(-100px) rotate(0deg);
        opacity: 0;
      }
      10% {
        opacity: 0.9;
      }
      90% {
        opacity: 0.8;
      }
      100% {
        transform: translateY(115vh) rotate(360deg);
        opacity: 0;
      }
    }

    /* Konten utama */
    .container {
      position: relative;
      z-index: 2;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 24px;
    }

    .heart {
      font-size: 48px;
      animation: heartbeat 1.3s infinite;
      filter: drop-shadow(0 0 15px #ff78bd);
    }

    @keyframes heartbeat {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.2); }
    }

    h1 {
      font-family: 'Pacifico', cursive;
      font-size: clamp(32px, 7vw, 65px);
      color: #ffb6d9;
      text-shadow: 0 0 15px #ff64b0, 0 0 35px #a64dff;
      animation: glow 2s ease-in-out infinite alternate;
      margin: 12px 0;
    }

    @keyframes glow {
      from {
        text-shadow: 0 0 10px #ff64b0;
      }
      to {
        text-shadow: 0 0 25px #ff64b0, 0 0 45px #b56cff;
      }
    }

    .name {
      font-size: clamp(25px, 5vw, 42px);
      font-weight: 700;
      letter-spacing: 5px;
      color: #fff0f7;
      margin-bottom: 12px;
    }

    .subtitle {
      font-size: 15px;
      color: #f5cce2;
      letter-spacing: 2px;
      margin-bottom: 24px;
    }

    .message {
      max-width: 470px;
      padding: 22px;
      border: 1px solid rgba(255, 182, 217, 0.5);
      background: rgba(255, 255, 255, 0.07);
      border-radius: 22px;
      backdrop-filter: blur(8px);
      box-shadow: 0 0 30px rgba(255, 105, 180, 0.12);
      line-height: 1.9;
      font-size: 14px;
    }

    .message span {
      color: #ffafd7;
      font-weight: 600;
    }

    button {
      margin-top: 25px;
      padding: 13px 26px;
      border: none;
      border-radius: 30px;
      background: linear-gradient(90deg, #ff83bd, #c58aff);
      color: #28142d;
      font-family: inherit;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 0 20px #ff83bd66;
      transition: transform 0.3s;
    }

    button:hover {
      transform: scale(1.08);
    }

    #surprise {
      display: none;
      margin-top: 20px;
      color: #ffc5e3;
      font-size: 17px;
      animation: appear 1s ease;
    }

    @keyframes appear {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .footer {
      margin-top: 25px;
      font-size: 11px;
      letter-spacing: 2px;
      color: #c9abc9;
    }

    .sparkle {
      position: fixed;
      bottom: -30px;
      z-index: 1;
      pointer-events: none;
      animation: floatUp 7s linear forwards;
    }

    @keyframes floatUp {
      to {
        transform: translateY(-110vh) rotate(360deg);
        opacity: 0;
      }
    }
  </style>
</head>

<body>
  <div class="rain" id="rain"></div>

  <main class="container">
    <div class="heart">♡</div>

    <h1>Happy Birthday!</h1>

    <div class="name">LEE HEESEUNG</div>

    <p class="subtitle">✧ OUR FOREVER STAR ✧</p>

    <div class="message">
      To our precious <span>Heeseung ♡</span><br><br>
      Happy Birthday to the person who makes
      our days brighter just by existing.
      Thank you for your beautiful voice,
      your warm smile, and all the happiness
      you bring to us.<br><br>
      May your life always be filled with
      love, laughter, good health, and
      endless beautiful dreams. You deserve
      every little happiness in this world.<br><br>
      <span>We love you endlessly, Hee! 💗</span>
    </div>

    <button onclick="showSurprise()">
      Click for a surprise ♡
    </button>

    <div id="surprise">
      🎂 HAPPY BIRTHDAY, OUR ANGEL! 🎂<br>
      You will always be someone's favorite star ✨
    </div>

    <div class="footer">
      MADE WITH LOVE ♡ FOR LEE HEESEUNG
    </div>
  </main>

  <script>
    // Membuat hujan tulisan HAPPY BIRTHDAY
    const rain = document.getElementById("rain");
    const words = [
      "HAPPY BIRTHDAY ♡",
      "LEE HEESEUNG",
      "HAPPY HEE DAY ✨",
      "WE LOVE YOU",
      "♡ HAPPY BIRTHDAY ♡"
    ];

    for (let i = 0; i < 35; i++) {
      const text = document.createElement("div");
      text.className = "falling";
      text.innerText = words[
        Math.floor(Math.random() * words.length)
      ];

      text.style.left = Math.random() * 100 + "vw";
      text.style.animationDuration =
        (5 + Math.random() * 9) + "s";
      text.style.animationDelay =
        (-Math.random() * 12) + "s";
      text.style.fontSize =
        (10 + Math.random() * 9) + "px";

      rain.appendChild(text);
    }

    // Tombol kejutan
    function showSurprise() {
      const surprise = document.getElementById("surprise");
      surprise.style.display = "block";

      // Hujan hati dan bintang
      for (let i = 0; i < 35; i++) {
        setTimeout(() => {
          const item = document.createElement("div");
          item.className = "sparkle";
          item.innerText = ["💗", "♡", "✨", "💜", "🎂"][
            Math.floor(Math.random() * 5)
          ];

          item.style.left = Math.random() * 100 + "vw";
          item.style.fontSize =
            (16 + Math.random() * 22) + "px";
          item.style.animationDuration =
            (4 + Math.random() * 4) + "s";

          document.body.appendChild(item);

          setTimeout(() => item.remove(), 8000);
        }, i * 100);
      }
    }
  </script>
</body>
</html>
